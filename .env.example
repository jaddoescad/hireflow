NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Canonical URL, used for invitation links and same-origin validation.
APP_URL=http://localhost:3100
# SMTP team invitations and interview organizer confirmations. Auth email delivery is configured in Supabase.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Direct Gmail connection (Google OAuth web client, read-only Gmail scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a private 32-byte base64 key; keep stable to decrypt saved connections.
GMAIL_TOKEN_KEY=
# Protect the automatic Gmail sync endpoint.
CRON_SECRET=
# Optional comma-separated trusted application notifier addresses.
GMAIL_APPLICATION_SENDERS=
# Optional Google Meet instant updates (Workspace Events via authenticated Pub/Sub push)
MEET_EVENTS_TOPIC=
MEET_EVENTS_PUSH_ACCOUNT=
